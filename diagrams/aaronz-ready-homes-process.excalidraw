    {
      "id": "readyproc-30",
      "type": "text",
      "x": 54,
      "y": 667.8,
      "width": 1524,
      "height": 114.4,
      "angle": 0,
      "strokeColor": "#a12b2b",
      "backgroundColor": "transparent",
