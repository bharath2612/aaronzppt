      "seed": 237570,
      "version": 1,
      "versionNonce": 29910,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1795680000000,
      "link": null,
      "locked": false,
      "text": "THE BIGGEST RISK: CHEQUE PICKUP AND DELIVERY\nThe 2% cheque has to travel from the broker to AaronzPay, and be back in the buyer's hand on transfer day.\nThe swap is hand to hand: the buyer gives the manager's cheque and takes the non-cashable cheque back on the spot.\nThe manager's cheque then has to reach the finance partner. The buyer's process should not change.",
      "originalText": "THE BIGGEST RISK: CHEQUE PICKUP AND DELIVERY\nThe 2% cheque has to travel from the broker to AaronzPay, and be back in the buyer's hand on transfer day.\nThe swap is hand to hand: the buyer gives the manager's cheque and takes the non-cashable cheque back on the spot.\nThe manager's cheque then has to reach the finance partner. The buyer's process should not change.",
      "fontSize": 22,
      "fontFamily": 2,
      "lineHeight": 1.3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "readyproc-29",
      "autoResize": false
    },
