      "boundElements": [],
      "updated": 1795680000000,
      "link": null,
      "locked": false,
      "text": "WHAT CHANGES FOR EACH PARTY\nBuyer: two cheques in place of one\nBroker: uploads from a phone, one visit at the end\nAaronzPay: no pickup or delivery of the 2% cheque\nTransfer day: the same swap as today",
      "originalText": "WHAT CHANGES FOR EACH PARTY\nBuyer: two cheques in place of one\nBroker: uploads from a phone, one visit at the end\nAaronzPay: no pickup or delivery of the 2% cheque\nTransfer day: the same swap as today",
      "fontSize": 22,
      "fontFamily": 2,
      "lineHeight": 1.3,
      "textAlign": "center",
